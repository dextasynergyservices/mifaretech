# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (Neon, Frankfurt)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/db?sslmode=require          # pooled, used at runtime
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/db?sslmode=require # direct, used for migrations

# Auth (Better Auth)
BETTER_AUTH_SECRET=            # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000

# Misc security
IP_HASH_SALT=                  # openssl rand -hex 24
CRON_SECRET=                   # openssl rand -hex 24

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="Mifaretech <no-reply@mifaretech.co.uk>"
SALES_INBOX=sales@mifaretech.co.uk

# Captcha (Google reCAPTCHA v3)
RECAPTCHA_SECRET_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Storage (Cloudinary — from the Cloudinary console dashboard)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=mifaretech
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Contact
NEXT_PUBLIC_WHATSAPP_NUMBER=44xxxxxxxxxx

# Local-only, used once by db:seed:admin — never set in Vercel
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=