{
  "name": "mifaretech",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "postinstall": "lefthook install",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "ci": "biome ci .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run src/db/seed.ts",
    "db:seed:admin": "bun run src/db/seed-admin.ts",
    "auth:generate": "better-auth generate --config src/lib/auth.ts --output src/db/schema/auth.ts",
    "clean": "rm -rf .next .turbo node_modules/.cache",
    "validate": "bun run lint && bun run format && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@hookform/resolvers": "5.9.1",
    "@neondatabase/serverless": "1.1.0",
    "@react-email/components": "1.0.12",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-table": "9.2.4",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "better-auth": "1.7.6",
    "class-variance-authority": "0.7.1",
    "cloudinary": "2.11.0",
    "clsx": "2.1.1",
    "cn": "0.4.0",
    "drizzle-orm": "0.45.3",
    "drizzle-zod": "0.8.3",
    "lenis": "1.3.26",
    "lucide-react": "1.48.0",
    "motion": "13.4.3",
    "next": "16.3.6",
    "next-themes": "0.4.6",
    "nuqs": "2.10.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.88.0",
    "resend": "6.29.0",
    "sanitize-html": "2.17.7",
    "server-only": "0.0.1",
    "shadcn": "4.21.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@better-auth/cli": "1.4.21",
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "2.16.1",
    "dotenv": "18.0.3",
    "drizzle-kit": "0.31.11",
    "lefthook": "2.1.14",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.2"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "lefthook",
    "sharp",
    "unrs-resolver"
  ]
}
